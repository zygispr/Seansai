# Dependencies and build output are recreated inside the image.
node_modules
**/node_modules
**/dist
coverage
playwright-report
test-results
*.log*

# Local data and secrets never go into the image.
apps/api/data
*.sqlite
*.sqlite-*
.env
.env.*

# Not needed to build or run.
.git
.github
.claude
.specify
.vscode
.idea
specs
apps/*/tests
Dockerfile*
.dockerignore
